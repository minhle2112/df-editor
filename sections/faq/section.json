{
	"type": "faq",
	"version": 1,
	"label": "FAQ / Akkordeon",
	"description": "Questions and answers as an accessible accordion in one or two columns, or with the heading and a contact card on the left.",
	"variants": {
		"one-col": "Eine Spalte",
		"two-col": "Zwei Spalten",
		"split": "Kopf links"
	},
	"options": {
		"style": { "label": "Stil", "values": ["lines", "cards"], "default": "lines", "labels": { "lines": "Lines", "cards": "Cards" } },
		"head_align": { "label": "Kopf-Ausrichtung", "values": ["left", "center"], "default": "left", "variants": ["one-col", "two-col"], "labels": { "left": "Left", "center": "Centred (narrow list)" } },
		"divider": { "label": "Trennlinie unter dem Kopf", "values": ["no", "yes"], "default": "no", "labels": { "no": "No divider", "yes": "Short divider" } },
		"open_first": { "label": "Erste Frage geöffnet", "values": ["yes", "no"], "default": "no", "labels": { "yes": "First question open", "no": "All questions closed" } },
		"single_open": { "label": "Nur eine Frage gleichzeitig offen", "values": ["yes", "no"], "default": "no", "labels": { "yes": "One question open at a time", "no": "Several questions can be open" } },
		"schema": { "label": "FAQPage-Schema ausgeben", "values": ["yes", "no"], "default": "no", "labels": { "yes": "Output FAQPage schema", "no": "No schema" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "FAQ", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Häufige Fragen", "max_length": 100 },
		"intro": { "type": "richtext", "optional": true, "label": "Einleitung", "default": "", "max_length": 600 },
		"more": { "type": "richtext", "optional": true, "label": "Fußzeile unter den Fragen", "default": "", "max_length": 300 },
		"contact_title": { "type": "text", "optional": true, "label": "Kontaktkarte: Titel", "default": "", "max_length": 80 },
		"contact_text": { "type": "richtext", "optional": true, "label": "Kontaktkarte: Text", "default": "", "max_length": 300 },
		"contact_cta": { "type": "button", "optional": true, "label": "Kontaktkarte: Button", "default": { "text": "", "url": "" }, "max_length": 40 },
		"contact_image": { "type": "image", "optional": true, "label": "Kontaktkarte: Bild", "aspect_ratio": "1/1" }
	},
	"list": {
		"key": "items",
		"item_label": "Frage",
		"min": 1,
		"max": 12,
		"default_count": 5,
		"fields": {
			"question": { "type": "text", "label": "Frage", "default": "Frage {n}?", "max_length": 160 },
			"answer": { "type": "richtext", "label": "Antwort", "default": "<p>Antwort auf Frage {n}.</p>", "max_length": 1500 }
		}
	}
}
