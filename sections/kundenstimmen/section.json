{
	"type": "kundenstimmen",
	"version": 1,
	"script": "on-demand",
	"label": "Kundenstimmen",
	"description": "Customer testimonials as a grid, a single large quote or a slider.",
	"variants": {
		"grid": "Raster",
		"single": "Einzelne Stimme",
		"slider": "Slider"
	},
	"options": {
		"source": { "label": "Quelle", "values": ["manual", "cpt"], "default": "manual", "labels": { "manual": "Entered on this page", "cpt": "Testimonial entries" } },
		"photos": { "label": "Fotos anzeigen", "values": ["yes", "no"], "default": "yes", "labels": { "yes": "Show photos", "no": "Hide photos" } },
		"head_style": { "label": "Kopf-Stil", "values": ["default", "compact"], "default": "default", "labels": { "default": "Default heading", "compact": "Compact, centred (e.g. a rating line)" } },
		"card_style": { "label": "Kartenstil", "values": ["tinted", "border"], "default": "tinted", "labels": { "tinted": "Tinted background", "border": "Outline on the page background" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "Kundenstimmen", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Das sagen unsere Kunden", "max_length": 100 },
		"intro": { "type": "richtext", "optional": true, "label": "Einleitung", "default": "", "max_length": 400 },
		"disclosure_title": { "type": "text", "optional": true, "label": "Aufklappbereich: Titel", "default": "", "max_length": 100 },
		"disclosure_text": { "type": "richtext", "optional": true, "label": "Aufklappbereich: Text", "default": "", "max_length": 800 }
	},
	"list": {
		"key": "items",
		"item_label": "Stimme",
		"min": 1,
		"max": 9,
		"default_count": 3,
		"fields": {
			"quote": { "type": "richtext", "label": "Zitat", "default": "<p>Schnell, sauber und freundlich – wir sind rundum zufrieden und empfehlen den Betrieb gerne weiter.</p>", "max_length": 400 },
			"name": { "type": "text", "label": "Name", "default": "Kundin {n}", "max_length": 60 },
			"company": { "type": "text", "optional": true, "label": "Firma / Ort", "default": "Köln", "max_length": 80 },
			"source": { "type": "text", "optional": true, "label": "Quelle (Badge)", "default": "", "max_length": 40 },
			"link": { "type": "button", "optional": true, "label": "Link", "default": { "text": "", "url": "" }, "max_length": 40 },
			"image": { "type": "image", "optional": true, "label": "Foto", "aspect_ratio": "1/1" },
			"rating": { "type": "setting", "label": "Sterne 0–5 (nur Agentur, Layout-JSON)", "values": ["0", "1", "2", "3", "4", "5"], "default": "0" }
		}
	}
}
