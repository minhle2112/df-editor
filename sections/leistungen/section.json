{
	"type": "leistungen",
	"version": 1,
	"label": "Leistungen (Karten)",
	"description": "Service cards in two to four columns with icon, image or frame style.",
	"variants": {
		"cards-icon": "Karten mit Icon",
		"cards-image": "Karten mit Bild",
		"cards-border": "Karten mit Rahmen"
	},
	"options": {
		"columns": { "label": "Spalten", "values": ["2", "3", "4"], "default": "3", "labels": { "2": "2 columns", "3": "3 columns", "4": "4 columns" } },
		"card_link": { "label": "Ganze Karte verlinkt", "values": ["yes", "no"], "default": "yes", "labels": { "yes": "Whole card is a link", "no": "Only the button is a link" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "Leistungen", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Unsere Leistungen", "max_length": 100 },
		"intro": { "type": "richtext", "optional": true, "label": "Einleitung", "default": "", "max_length": 600 }
	},
	"list": {
		"key": "items",
		"item_label": "Leistung",
		"min": 2,
		"max": 12,
		"default_count": 3,
		"fields": {
			"title": { "type": "text", "label": "Titel", "default": "Leistung {n}", "max_length": 60 },
			"text": { "type": "richtext", "label": "Text", "default": "<p>Kurze Beschreibung der Leistung in ein bis zwei Sätzen.</p>", "max_length": 400 },
			"image": { "type": "image", "label": "Bild", "aspect_ratio": "4/3" },
			"link": { "type": "button", "optional": true, "label": "Link", "default": { "text": "Mehr erfahren", "url": "#" }, "max_length": 40 },
			"icon": { "type": "setting", "label": "Icon (nur Agentur, Layout-JSON)", "values": ["check", "phone", "mail", "clock", "map-pin", "star", "shield", "wrench", "flame", "droplet", "home", "leaf", "bolt", "users", "calendar", "arrow-right", "none"], "default": "" }
		}
	}
}
