{
	"type": "kacheln",
	"version": 1,
	"label": "Kacheln",
	"description": "Grid of small cards (links, steps, facts, values), optionally next to a text column.",
	"variants": {
		"grid": "Raster",
		"split": "Text links + Kacheln rechts"
	},
	"options": {
		"columns": { "label": "Spalten", "values": ["2", "3", "4", "5"], "default": "3", "labels": { "2": "2 columns", "3": "3 columns", "4": "4 columns", "5": "5 columns" } },
		"card_style": { "label": "Kartenstil", "values": ["border", "tinted", "plain"], "default": "border", "labels": { "border": "Card with border", "tinted": "Tinted card", "plain": "No card" } },
		"marker": { "label": "Markierung", "values": ["none", "icon", "number", "arrow"], "default": "none", "labels": { "none": "No marker", "icon": "Icon", "number": "Step number", "arrow": "Arrow circle" } },
		"card_link": { "label": "Ganze Karte verlinkt", "values": ["yes", "no"], "default": "no", "labels": { "yes": "Whole card is a link", "no": "Only the link is clickable" } },
		"head_align": { "label": "Kopf-Ausrichtung", "values": ["left", "center"], "default": "left", "variants": ["grid"], "labels": { "left": "Head left", "center": "Head centred" } },
		"divider": { "label": "Linie unter der Überschrift", "values": ["yes", "no"], "default": "no", "labels": { "yes": "Accent line under the heading", "no": "No line" } },
		"highlight_first": { "label": "Erste Karte hervorheben", "values": ["yes", "no"], "default": "no", "labels": { "yes": "Highlight first card", "no": "All cards equal" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Überschrift", "max_length": 100 },
		"title_accent": { "type": "text", "optional": true, "label": "Überschrift Akzentzeile", "default": "", "max_length": 80 },
		"intro": { "type": "richtext", "optional": true, "label": "Einleitung", "default": "", "max_length": 600 },
		"text": { "type": "richtext", "optional": true, "label": "Text", "default": "", "max_length": 1200 },
		"cta": { "type": "button", "optional": true, "label": "Button", "default": { "text": "", "url": "" }, "max_length": 40 }
	},
	"list": {
		"key": "items",
		"item_label": "Kachel",
		"min": 1,
		"max": 12,
		"default_count": 3,
		"fields": {
			"kicker": { "type": "text", "optional": true, "label": "Kicker", "default": "", "max_length": 40 },
			"title": { "type": "text", "label": "Titel", "default": "Kachel {n}", "max_length": 60 },
			"text": { "type": "richtext", "optional": true, "label": "Text", "default": "<p>Ein bis zwei Sätze zu diesem Punkt.</p>", "max_length": 400 },
			"link": { "type": "button", "optional": true, "label": "Link", "default": { "text": "", "url": "" }, "max_length": 40 },
			"icon": { "type": "setting", "label": "Icon", "values": ["", "check", "phone", "mail", "clock", "map-pin", "star", "shield", "wrench", "flame", "droplet", "home", "leaf", "bolt", "users", "calendar", "arrow-right", "building", "play", "target", "eye", "gem", "heart", "moon", "none"], "labels": { "": "Automatic", "none": "No icon" }, "default": "" }
		}
	}
}
