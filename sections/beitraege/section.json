{
	"type": "beitraege",
	"version": 1,
	"label": "Beiträge",
	"description": "Teaser cards for blog posts: entered on the page or the latest posts.",
	"variants": {
		"grid": "Raster"
	},
	"options": {
		"source": { "label": "Quelle", "values": ["manual", "posts"], "default": "manual", "labels": { "manual": "Entered on this page", "posts": "Latest posts" } },
		"category": { "label": "Kategorie (Slug, nur Quelle Beiträge)", "values": [], "default": "" },
		"columns": { "label": "Spalten", "values": ["2", "3"], "default": "3", "labels": { "2": "2 columns", "3": "3 columns" } },
		"show_meta": { "label": "Meta anzeigen", "values": ["yes", "no"], "default": "yes", "labels": { "yes": "Show reading time / date", "no": "Hide meta" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "Blog", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Aktuelles", "max_length": 100 },
		"intro": { "type": "richtext", "optional": true, "label": "Einleitung", "default": "", "max_length": 600 },
		"more": { "type": "button", "optional": true, "label": "Link oben rechts", "default": { "text": "Alle Beiträge", "url": "/blog/" }, "max_length": 40 },
		"cta": { "type": "button", "optional": true, "label": "Button unten", "default": { "text": "", "url": "" }, "max_length": 40 }
	},
	"list": {
		"key": "items",
		"item_label": "Beitrag",
		"min": 1,
		"max": 12,
		"default_count": 3,
		"fields": {
			"image": { "type": "image", "label": "Beitragsbild", "aspect_ratio": "16/10" },
			"category": { "type": "text", "optional": true, "label": "Kategorie", "default": "Kategorie", "max_length": 30 },
			"meta": { "type": "text", "optional": true, "label": "Meta (Lesezeit · Datum)", "default": "", "max_length": 40 },
			"title": { "type": "text", "label": "Titel", "default": "Beitragstitel {n}", "max_length": 100 },
			"text": { "type": "richtext", "optional": true, "label": "Anreißer", "default": "<p>Ein bis zwei Sätze zum Beitrag.</p>", "max_length": 300 },
			"link": { "type": "button", "label": "Link", "default": { "text": "Weiterlesen", "url": "#" }, "max_length": 30 }
		}
	}
}
