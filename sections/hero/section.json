{
	"type": "hero",
	"version": 1,
	"label": "Hero",
	"description": "Page opener with heading, lead text, buttons and an optional image.",
	"variants": {
		"split": "Text + Bild",
		"overlay": "Bild mit Overlay",
		"text": "Nur Text"
	},
	"options": {
		"image_side": { "label": "Bildposition", "values": ["left", "right"], "default": "right", "variants": ["split"], "labels": { "left": "Image left", "right": "Image right" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h1", "h2"], "default": "h1", "labels": { "h1": "Heading 1 (H1)", "h2": "Heading 2 (H2)" } },
		"height": { "label": "Höhe", "values": ["auto", "70", "full"], "default": "auto", "labels": { "auto": "Fit content", "70": "70% of the screen", "full": "Full screen" } },
		"buttons": { "label": "Anzahl Buttons", "values": ["0", "1", "2"], "default": "1", "labels": { "0": "No buttons", "1": "One button", "2": "Two buttons" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "label": "Dachzeile", "default": "Willkommen", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Überschrift", "max_length": 80 },
		"text": { "type": "richtext", "label": "Text", "default": "<p>Kurzer Einleitungstext, der in zwei Sätzen erklärt, was Sie anbieten.</p>", "max_length": 400 },
		"cta1": { "type": "button", "label": "Button 1", "default": { "text": "Kontakt", "url": "/kontakt/" }, "max_length": 40 },
		"cta2": { "type": "button", "label": "Button 2", "default": { "text": "Mehr erfahren", "url": "#" }, "max_length": 40 },
		"image": { "type": "image", "label": "Bild", "aspect_ratio": "4/3" }
	}
}
