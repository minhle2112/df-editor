{
	"type": "termin",
	"version": 1,
	"label": "Termin",
	"description": "Highlight one event: split teaser with image or compact card with key facts.",
	"variants": {
		"feature": "Einladung mit Bild",
		"card": "Kompakte Termin-Karte"
	},
	"options": {
		"image_side": { "label": "Bildposition", "values": ["left", "right"], "default": "right", "variants": ["feature"], "labels": { "left": "Image left", "right": "Image right" } },
		"image_style": { "label": "Bildstil", "values": ["plain", "rounded", "shadow"], "default": "shadow", "variants": ["feature"], "labels": { "plain": "Plain", "rounded": "Rounded corners", "shadow": "With shadow" } },
		"buttons": { "label": "Anzahl Buttons", "values": ["0", "1", "2"], "default": "1", "labels": { "0": "No button", "1": "One button", "2": "Two buttons" } },
		"marker": { "label": "Markierung (Karte)", "values": ["icon", "image", "none"], "default": "icon", "variants": ["card"], "labels": { "icon": "Icon tile", "image": "Small image", "none": "Nothing" } },
		"icon": { "label": "Icon (Karte)", "values": ["calendar", "clock", "map-pin", "star", "users", "home", "leaf", "heart", "moon", "eye", "gem", "target", "play", "building", "check", "mail", "phone"], "default": "calendar", "variants": ["card"] },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "Nächster Termin", "max_length": 60 },
		"title": { "type": "text", "label": "Titel", "default": "Titel der Veranstaltung", "max_length": 100 },
		"date": { "type": "text", "optional": true, "label": "Datum / Ort", "default": "", "max_length": 100 },
		"text": { "type": "richtext", "optional": true, "label": "Text", "default": "<p>Kurze Beschreibung der Veranstaltung.</p>", "max_length": 600 },
		"cta1": { "type": "button", "optional": true, "label": "Button 1", "default": { "text": "Anmelden", "url": "#" }, "max_length": 40 },
		"cta2": { "type": "button", "optional": true, "label": "Button 2", "default": { "text": "", "url": "" }, "max_length": 40 },
		"note": { "type": "text", "optional": true, "label": "Hinweis", "default": "", "max_length": 140 },
		"image": { "type": "image", "label": "Bild", "aspect_ratio": "4/3" },
		"caption": { "type": "text", "optional": true, "label": "Bildunterschrift", "default": "", "max_length": 120 }
	},
	"list": {
		"key": "facts",
		"item_label": "Eckdatum",
		"min": 0,
		"max": 4,
		"default_count": 3,
		"fields": {
			"label": { "type": "text", "label": "Eckdatum", "default": "Eckdatum {n}", "max_length": 40 }
		}
	}
}
