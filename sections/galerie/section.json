{
	"type": "galerie",
	"version": 1,
	"script": "on-demand",
	"label": "Galerie",
	"description": "Image gallery as a grid or masonry with optional captions and lightbox.",
	"variants": {
		"grid": "Raster",
		"masonry": "Masonry"
	},
	"options": {
		"columns": { "label": "Spalten", "values": ["2", "3", "4", "5"], "default": "3", "labels": { "2": "2 columns", "3": "3 columns", "4": "4 columns", "5": "5 columns" } },
		"ratio": { "label": "Bildformat (Raster)", "values": ["1-1", "4-3", "16-9", "original"], "default": "4-3", "variants": ["grid"], "labels": { "1-1": "Square (1:1)", "4-3": "Landscape (4:3)", "16-9": "Wide (16:9)", "original": "Original format" } },
		"lightbox": { "label": "Lightbox", "values": ["yes", "no"], "default": "yes", "labels": { "yes": "Open images in a lightbox", "no": "No lightbox" } },
		"captions": { "label": "Bildunterschriften anzeigen", "values": ["yes", "no"], "default": "no", "labels": { "yes": "Show captions", "no": "Hide captions" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "label": "Dachzeile", "default": "", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Galerie", "max_length": 100 },
		"intro": { "type": "richtext", "label": "Einleitung", "default": "", "max_length": 600 }
	},
	"list": {
		"key": "items",
		"min": 1,
		"max": 24,
		"default_count": 6,
		"fields": {
			"image": { "type": "image", "label": "Bild" },
			"caption": { "type": "text", "label": "Bildunterschrift", "default": "", "max_length": 120 }
		}
	}
}
