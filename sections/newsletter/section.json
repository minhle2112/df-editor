{
	"type": "newsletter",
	"version": 1,
	"label": "Newsletter",
	"description": "Newsletter sign-up with consent checkbox, centred or next to the text.",
	"variants": {
		"centered": "Zentriert",
		"split": "Text + Formular nebeneinander"
	},
	"options": {
		"provider": { "label": "Anbindung", "values": ["none", "action", "shortcode"], "default": "none", "labels": { "none": "Not connected yet", "action": "Post to a provider URL", "shortcode": "Form plugin shortcode" } },
		"action_url": { "label": "Formular-Action-URL (Brevo, CleverReach, Mailchimp …)", "values": [], "default": "" },
		"shortcode": { "label": "Shortcode (z. B. Fluent Forms / CF7)", "values": [], "default": "" },
		"show_name": { "label": "Vorname abfragen", "values": ["yes", "no"], "default": "yes", "labels": { "yes": "Ask for first name", "no": "E-mail only" } },
		"heading_level": { "label": "Überschrift-Ebene", "values": ["h2", "h3"], "default": "h2", "labels": { "h2": "Heading 2 (H2)", "h3": "Heading 3 (H3)" } }
	},
	"fields": {
		"eyebrow": { "type": "text", "optional": true, "label": "Dachzeile", "default": "", "max_length": 60 },
		"title": { "type": "text", "label": "Überschrift", "default": "Newsletter abonnieren", "max_length": 80 },
		"text": { "type": "richtext", "optional": true, "label": "Text", "default": "<p>Neuigkeiten etwa einmal im Monat.</p>", "max_length": 300 },
		"name_label": { "type": "text", "label": "Feld Vorname", "default": "Vorname", "max_length": 40 },
		"name_placeholder": { "type": "text", "optional": true, "label": "Platzhalter Vorname", "default": "Dein Vorname", "max_length": 40 },
		"email_label": { "type": "text", "label": "Feld E-Mail", "default": "E-Mail", "max_length": 40 },
		"email_placeholder": { "type": "text", "optional": true, "label": "Platzhalter E-Mail", "default": "Deine E-Mail-Adresse", "max_length": 60 },
		"consent": { "type": "richtext", "label": "Einwilligung", "default": "<p>Ja, ich möchte den Newsletter erhalten. Die <a href=\"/datenschutz/\">Datenschutzhinweise</a> habe ich gelesen.</p>", "max_length": 300 },
		"button_text": { "type": "text", "label": "Button", "default": "Anmelden", "max_length": 30 },
		"note": { "type": "text", "optional": true, "label": "Hinweis", "default": "Abmelden jederzeit möglich.", "max_length": 120 }
	}
}
