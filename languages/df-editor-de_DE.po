#. Plugin Name of the plugin
#: df-editor.php
msgid "DF Editor"
msgstr "DF Editor"

#. Description of the plugin
#: df-editor.php
msgid "Section library, page layouts and front-end content editing (DF Inhalt) by Digitale Formate."
msgstr "Section-Bibliothek, Seitenlayouts und Inhaltsbearbeitung im Frontend (DF Inhalt) von Digitale Formate."

#. Author of the plugin
#: df-editor.php
msgid "Digitale Formate"
msgstr "Digitale Formate"

#: assets/blocks/editor.js:364
msgid "The page has unsaved changes. They must be saved (and go live) before you edit the texts. Save now?"
